	cp "/home/root/.vellum/share/rmpp-tailscale"/boot /usr/lib/rmpp/boot.d/50-rmpp-tailscale.new && chmod 755 /usr/lib/rmpp/boot.d/50-rmpp-tailscale.new && { [ ! -e /usr/lib/rmpp/boot.d/50-rmpp-tailscale ] || mv -f /usr/lib/rmpp/boot.d/50-rmpp-tailscale /usr/lib/rmpp/boot.d/50-rmpp-tailscale.old; } && mv -f /usr/lib/rmpp/boot.d/50-rmpp-tailscale.new /usr/lib/rmpp/boot.d/50-rmpp-tailscale
	cp "/home/root/.vellum/share/rmpp-tailscale"/rmpp-tailscaled.service /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service.new && chmod 644 /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service.new && { [ ! -e /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service ] || mv -f /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service.old; } && mv -f /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service.new /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscaled.service
	cp "/home/root/.vellum/share/rmpp-tailscale"/rmpp-tailscale-ssh.socket /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket.new && chmod 644 /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket.new && { [ ! -e /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket ] || mv -f /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket.old; } && mv -f /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket.new /usr/lib/rmpp/units/rmpp-tailscale/rmpp-tailscale-ssh.socket
