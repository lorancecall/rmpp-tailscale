		mkdir -p /usr/lib/rmpp/.trash
		rm -f /usr/lib/rmpp-preload.d/50-rmpp-tailscale.so /usr/lib/systemd/system/multi-user.target.wants/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscaled.service /usr/lib/systemd/system/rmpp-tailscale-ssh.socket /usr/lib/systemd/system/rmpp-tailscale-ssh@.service
