# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the tablet off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: everything under /usr/lib/rmpp (rmpp-preload's layout); a file xochitl may have loaded is
# renamed to *.old or moved to /usr/lib/rmpp/.trash, never deleted, and /usr/lib/rmpp/restart deletes it after the
# restart. Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.
# The Tailscale binaries (~70 MB) stay in /home (Vellum's share folder); the unit waits for /home.
# SSH: rmpp-tailscale-ssh.socket listens on lo (tailscaled hands incoming connections to loopback).
# Tailscale starts off; it is turned on from Settings > Tailscale (flag file in /home/root/.config/rmpp-tailscale).

package() {
	install -Dm755 "$srcdir"/librmpp-tailscale.so "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/librmpp-tailscale.so
	install -Dm644 "$srcdir"/rmpp-tailscale.rcc "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/rmpp-tailscale.rcc
	install -Dm644 "$srcdir"/rmpp-tailscaled.service "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/rmpp-tailscaled.service
	install -Dm644 "$srcdir"/rmpp-tailscale-ssh.socket "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/rmpp-tailscale-ssh.socket
	install -Dm644 "$srcdir"/rmpp-tailscale-ssh@.service "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/rmpp-tailscale-ssh@.service
	install -Dm755 "$srcdir"/tailscale_${_tsver}_arm64/tailscale "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/tailscale
	install -Dm755 "$srcdir"/tailscale_${_tsver}_arm64/tailscaled "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/tailscaled
	install -Dm644 "$srcdir"/rmpp-tailscale.env "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/rmpp-tailscale.env
	install -Dm755 "$srcdir"/boot "$pkgdir"/home/root/.vellum/share/rmpp-tailscale/boot

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	printf '%s\n' "https://github.com/$upstream_author/rmpp-tailscale" "https://github.com/tailscale/tailscale (BSD-3-Clause)" \
		"https://github.com/nayuki/QR-Code-generator (MIT)" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

